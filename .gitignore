# Track only the modpack's editable sources and documentation at the root.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/docs/
!/config/
!/defaultconfigs/
!/kubejs/
!/scripts/
!/datapacks/
!/resourcepacks/
!/openloader/
!/global_packs/
!/packmenu/
!/patchouli_books/
!/manifest.json
!/modlist.html
!/mod-list.txt

# Runtime data and generated output, including nested copies.
**/saves/
**/logs/
**/crash-reports/
**/backups/
**/screenshots/
**/cache/
**/.cache/
**/node_modules/
/kubejs/exported/
/kubejs/probe/
*.log
*.log.*
*.tmp
*.bak
*.old

# Keep downloaded mods and archives out of Git.
*.jar
*.zip
*.7z
*.rar
*.tar
*.gz
*.exe
*.dll
*.class

# Common credentials and machine-specific files.
.env
.env.*
credentials.json
secrets.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.DS_Store
Thumbs.db
desktop.ini
**/.idea/
**/.vscode/
